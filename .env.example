# Copy to .env and adjust. Used by docker-compose.yml. Never commit .env.

# --- Database (Postgres) ---
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex

# --- Backend ---
# Required. Must be at least 32 bytes long. Compose refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Host ports ---
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8081
