### Variables (use 8080 for local runs, or the API_PORT you set for Docker)
@host = http://localhost:8080
@token = PASTE_THE_TOKEN_HERE

### Catalogue (public)
GET {{host}}/api/v1/pokeapi/pokemon?page=0&size=20

### Detail by id or name (public)
GET {{host}}/api/v1/pokeapi/pokemon/pikachu

### Sign up
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{ "username": "ash", "email": "ash@example.com", "password": "Pikachu123" }

### Log in (copy accessToken into @token)
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{ "username": "demo", "password": "Demo1234!" }

### Current user
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{token}}

### Sync one Pokémon (201 if new, 200 if it already existed)
POST {{host}}/api/v1/pokemon/sync/25
Authorization: Bearer {{token}}

### Local list with filters (public)
GET {{host}}/api/v1/pokemon?page=0&size=10&region=kanto&tag=starter

### Edit own fields with version check
PUT {{host}}/api/v1/pokemon/1
Authorization: Bearer {{token}}
Content-Type: application/json
If-Match: "0"

{ "localName": "Little Seed", "region": "Kanto", "tags": ["starter", "grass"] }

### Partial edit (PATCH): only the fields you send change
PATCH {{host}}/api/v1/pokemon/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "region": "Johto" }

### Delete (ADMIN only; with the demo token it returns 403)
DELETE {{host}}/api/v1/pokemon/1
Authorization: Bearer {{token}}

### Bulk sync (ADMIN only)
POST {{host}}/api/v1/pokemon/sync?from=1&to=20
Authorization: Bearer {{token}}
